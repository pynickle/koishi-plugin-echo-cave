{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "bump",
  "ignoreDeps": ["uuid"],
  "packageRules": [
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "24.x"
    },
    {
      "enabled": false,
      "matchDepTypes": [
        "peerDependencies"
      ]
    }
  ]
}
